---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Tag from '../components/Tag.astro';

const teamMembers = await getCollection('equipa');

const values = [
  {
    name: 'PRECISO',
    desc: 'Sem tolerância para ambiguidades regulatórias, cálculos sem fundamentação ou especificações incompletas.',
  },
  {
    name: 'SÓBRIO',
    desc: 'Comunicação direta baseada em factos comprovados. Rejeitamos o hype, os chavões de marketing e as métricas artificiais.',
  },
  {
    name: 'TÉCNICO',
    desc: 'A profundidade da engenharia precede a estética. O sistema tem de ser formalmente robusto antes de ser demonstrado.',
  },
  {
    name: 'CURIOSO',
    desc: 'Investigação persistente na fronteira de domínios difíceis onde as ferramentas convencionais falham.',
  },
  {
    name: 'CONCRETO',
    desc: 'Foco no caso específico, no projeto real e nos seus parâmetros operacionais antes de qualquer abstração.',
  },
  {
    name: 'TRANSPARENTE',
    desc: 'Total rastreabilidade de código, dados e evidências. Quem usa os nossos sistemas sabe sempre porquê.',
  },
];
---

<Layout
  title="Sobre a BolinaTec | Engenharia Tecnológica Portuguesa"
  description="Conheça a BolinaTec: empresa portuguesa de engenharia tecnológica que investiga problemas complexos e desenvolve software, sistemas e produtos para os resolver."
>
  <!-- HERO SECTION -->
  <section class="py-24 md:py-32 px-6 md:px-12 lg:px-20 border-b border-white/[0.08] relative overflow-hidden bg-[#080808]">
    <div class="absolute inset-0 bg-grid-pattern opacity-30 pointer-events-none"></div>

    <div class="max-w-5xl mx-auto relative z-10">
      <div class="inline-flex items-center gap-2 mb-6">
        <Tag>SOBRE A EMPRESA</Tag>
        <span class="font-mono text-xs text-neutral-400">/ Identidade Institucional</span>
      </div>

      <h1
        class="text-4xl sm:text-5xl md:text-6xl font-light text-white tracking-tight leading-[1.05] mb-8"
        style="font-family: 'IBM Plex Sans', sans-serif;"
      >
        Engenharia tecnológica.<br />
        <span class="text-white font-normal underline decoration-white/30 underline-offset-8">Sem concessões ao ruído</span>.
      </h1>

      <p class="text-base md:text-lg text-neutral-300 max-w-2xl leading-relaxed font-sans mb-8">
        A BolinaTec é uma empresa portuguesa de engenharia tecnológica que investiga problemas complexos e desenvolve software, sistemas e produtos para os resolver.
      </p>

      <div class="p-6 rounded-2xl border border-white/[0.1] bg-[#0c0c0c] max-w-2xl font-mono text-xs text-neutral-300 space-y-2">
        <div><strong class="text-white">Tese Corporativa:</strong> Transformar complexidade em sistemas computáveis.</div>
        <div><strong class="text-white">Princípio Operacional:</strong> Problema antes da tecnologia. Evidência antes da afirmação.</div>
      </div>
    </div>
  </section>

  <!-- PRINCIPLES & VALUES -->
  <section id="principios" class="py-24 px-6 md:px-12 lg:px-20 border-b border-white/[0.08]">
    <div class="max-w-6xl mx-auto">
      <div class="max-w-2xl mb-16">
        <div class="mb-4">
          <Tag>PRINCÍPIOS E VALORES</Tag>
        </div>
        <h2 class="text-3xl md:text-4xl font-light text-white tracking-tight leading-tight mb-4">
          O que nos define e o que rejeitamos.
        </h2>
        <p class="text-sm text-neutral-400 leading-relaxed font-sans">
          Não somos uma agência de consultoria genérica nem uma fábrica de software descartável. Tratamos a computação como uma disciplina de engenharia rigorosa.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
        {values.map((val) => (
          <div class="p-7 rounded-2xl border border-white/[0.08] bg-[#0c0c0c] flex flex-col justify-between hover:border-white/20 transition-colors">
            <div>
              <h3 class="font-mono text-sm tracking-wider uppercase text-white font-semibold mb-3">
                {val.name}
              </h3>
              <p class="text-xs text-neutral-400 leading-relaxed font-sans">
                {val.desc}
              </p>
            </div>
          </div>
        ))}
      </div>

      <!-- WHAT WE ARE NOT -->
      <div class="p-8 rounded-2xl border border-white/[0.08] bg-[#090909]">
        <h3 class="font-mono text-xs uppercase tracking-wider text-rose-400 mb-4">
          O que a BolinaTec NÃO é
        </h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-xs text-neutral-400 leading-relaxed font-sans">
          <div>
            <strong class="text-white block mb-1 font-mono text-[11px]">NÃO SOMOS CONSULTORIA GENÉRICA</strong>
            Não vendemos horas de apresentação de diapositivos nem relatórios de transformação digital sem código executável.
          </div>
          <div>
            <strong class="text-white block mb-1 font-mono text-[11px]">NÃO SOMOS AGÊNCIA DE HYPE</strong>
            Não comercializamos chavões de inteligência artificial probabilística para processos que exigem garantias determinísticas de conformidade legal.
          </div>
          <div>
            <strong class="text-white block mb-1 font-mono text-[11px]">NÃO INVENTAMOS DADOS</strong>
            Não anunciamos métricas fictícias, logótipos de clientes inexistentes ou prémios vazios. O nosso trabalho fala pelo rigor do seu código e evidência.
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- LEADERSHIP & TEAM -->
  <section id="equipa" class="py-24 px-6 md:px-12 lg:px-20 border-b border-white/[0.08] bg-[#070707]">
    <div class="max-w-6xl mx-auto">
      <div class="max-w-2xl mb-16">
        <div class="mb-4">
          <Tag>LIDERANÇA E ENGENHARIA</Tag>
        </div>
        <h2 class="text-3xl md:text-4xl font-light text-white tracking-tight leading-tight mb-4">
          Quem pensa e quem constrói.
        </h2>
        <p class="text-sm text-neutral-400 leading-relaxed font-sans">
          Engenharia de sistemas, modelação matemática e desenvolvimento técnico na mesma equipa, sem intermediários entre a análise e a implementação.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {teamMembers.map((member) => (
          <div class="p-8 rounded-2xl border border-white/[0.08] bg-[#0c0c0c] flex flex-col justify-between">
            <div>
              <div class="flex items-center gap-4 mb-6">
                {member.data.photo ? (
                  <img
                    src={member.data.photo}
                    alt={member.data.name}
                    class="w-16 h-16 rounded-full object-cover border border-white/10"
                  />
                ) : (
                  <div class="w-16 h-16 rounded-full bg-white/[0.05] border border-white/[0.1] flex items-center justify-center font-mono text-lg text-white">
                    {member.data.name.charAt(0)}
                  </div>
                )}
                <div>
                  <h3 class="text-lg text-white font-medium">{member.data.name}</h3>
                  <div class="font-mono text-xs text-neutral-400">{member.data.role}</div>
                </div>
              </div>

              <p class="text-xs text-neutral-400 leading-relaxed font-sans">
                {member.data.shortBio || 'Liderança executiva e arquitetura técnica dos sistemas computáveis da BolinaTec, com foco em validação regulatória de projetos territoriais e engenharia determinística.'}
              </p>
            </div>

            <div class="mt-8 pt-4 border-t border-white/[0.05] font-mono text-[11px] text-neutral-500">
              Sede em Portugal
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CONTACT CTA -->
  <section class="py-20 px-6 md:px-12 lg:px-20 bg-[#080808]">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-2xl md:text-3xl font-light text-white tracking-tight mb-4">
        Quer falar com a equipa de engenharia?
      </h2>
      <p class="text-xs md:text-sm text-neutral-400 max-w-xl mx-auto leading-relaxed mb-8 font-sans">
        Partilhe o seu desafio técnico ou projeto. Respondemos com um próximo passo estruturado em 24h úteis.
      </p>
      <a
        href="/contacto"
        class="inline-block px-6 py-3 rounded-xl bg-white text-black font-mono text-xs uppercase tracking-wider font-semibold hover:bg-neutral-200 transition-all shadow-sm"
      >
        Entrar em Contacto
      </a>
    </div>
  </section>
</Layout>
