---
import Layout from '../layouts/Layout.astro';
import Tag from '../components/Tag.astro';
import ContactForm from '../components/ContactForm.astro';

const pipeline = [
  {
    step: '01',
    name: 'Projeto',
    label: 'Identificação Cadastral',
    desc: 'Localização geográfica precisa, polígono de intervenção e natureza da operação urbanística.',
  },
  {
    step: '02',
    name: 'Factos',
    label: 'Parâmetros Reais',
    desc: 'Área bruta de construção, área de implantação, cérceas, cota de soleira, usos propostos e afastamentos.',
  },
  {
    step: '03',
    name: 'Contexto Regulatório',
    label: 'Isolamento Normativo',
    desc: 'Identificação e seleção contextual dos artigos aplicáveis do PDM municipal, RJUE e servidões territoriais mapeadas.',
  },
  {
    step: '04',
    name: 'Requisitos Aplicáveis',
    label: 'Estruturação Lógica',
    desc: 'Decomposição de requisitos regulamentares em proposições verificáveis sem ambiguidade.',
  },
  {
    step: '05',
    name: 'Regras Computáveis',
    label: 'Cálculo e Modelação',
    desc: 'Fórmulas de índice de ocupação, planos de corte, cérceas máximas e polígonos permitidos.',
  },
  {
    step: '06',
    name: 'Verificações',
    label: 'Execução de Testes',
    desc: 'Execução reproduzível de verificações computáveis face aos parâmetros fornecidos pelo projeto.',
  },
  {
    step: '07',
    name: 'Evidência',
    label: 'Rastreabilidade Total',
    desc: 'Cada verificação regista o artigo exato, a redação legal e o cálculo que suporta o diagnóstico.',
  },
  {
    step: '08',
    name: 'Resultado',
    label: 'Diagnóstico em 4 Estados',
    desc: 'Diagnóstico estruturado e auditável: Conforme, Condicionado, Não Conforme ou Inconclusivo.',
  },
];
---

<Layout
  title="ImoHarmonia | Pré-validação de Projetos face a Regulamentos Urbanísticos — BolinaTec"
  description="O ImoHarmonia é o sistema de engenharia da BolinaTec que executa a pré-validação de projetos de arquitetura e engenharia face a regras computáveis de PDMs e normas urbanísticas."
>
  <!-- HERO SECTION -->
  <section class="py-24 md:py-32 px-6 md:px-12 lg:px-20 border-b border-white/[0.08] relative overflow-hidden bg-[#080808]">
    <div class="absolute inset-0 bg-grid-pattern opacity-30 pointer-events-none"></div>

    <div class="max-w-5xl mx-auto relative z-10">
      <div class="inline-flex items-center gap-2 mb-6">
        <Tag variant="product">EM VALIDAÇÃO COM PROJETOS REAIS</Tag>
        <span class="font-mono text-xs text-neutral-400">/ Urbanismo Computável</span>
      </div>

      <h1
        class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-light text-white tracking-tight leading-[1.05] mb-8"
        style="font-family: 'IBM Plex Sans', sans-serif;"
      >
        "Este projeto<br />
        <span class="text-white font-normal underline decoration-emerald-500/50 underline-offset-8">pode avançar?</span>"
      </h1>

      <p class="text-base md:text-lg text-neutral-300 max-w-2xl leading-relaxed font-sans mb-10">
        O ImoHarmonia é um sistema de engenharia que pré-valida projetos concretos de arquitetura e engenharia face a regras computáveis de regulamentos municipais e setoriais antes da submissão autárquica.
      </p>

      <div class="flex flex-col sm:flex-row items-center gap-4">
        <a
          href="#testar"
          class="w-full sm:w-auto px-6 py-3 rounded-xl bg-white text-black font-mono text-xs uppercase tracking-wider font-semibold hover:bg-neutral-200 transition-all shadow-md text-center"
        >
          Testar com um projeto
        </a>
        <a
          href="https://imoharmonia.com"
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto px-6 py-3 rounded-xl bg-[#141414] text-neutral-300 hover:text-white border border-white/[0.1] font-mono text-xs uppercase tracking-wider transition-all flex items-center justify-center gap-2"
        >
          <span>Visitar imoharmonia.com</span>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- THE REGULATORY COMPLEXITY -->
  <section class="py-24 px-6 md:px-12 lg:px-20 border-b border-white/[0.08]">
    <div class="max-w-6xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div>
          <div class="mb-4">
            <Tag>A COMPLEXIDADE TERRITORIAL</Tag>
          </div>
          <h2 class="text-3xl md:text-4xl font-light text-white tracking-tight leading-tight mb-6">
            Cada município acrescenta instrumentos, regras, cartografia e contexto próprios.
          </h2>
          <p class="text-sm text-neutral-300 leading-relaxed font-sans mb-4">
            O licenciamento de um projeto de edificação em Portugal cruza o Plano Diretor Municipal (PDM) local, o Regime Jurídico da Urbanização e Edificação (RJUE), o RGEU e regimes de proteção territorial (REN, RAN, património classificado, domínio hídrico).
          </p>
          <p class="text-sm text-neutral-400 leading-relaxed font-sans">
            A leitura manual de centenas de páginas dispersas consome tempo crítico e frequentemente descobre inconformidades quando o projeto já se encontra formalmente submetido, gerando rejeições liminares e aditamentos onerosos.
          </p>
        </div>

        <div class="space-y-4">
          <div class="p-6 rounded-xl border border-white/[0.08] bg-[#0c0c0c]">
            <span class="font-mono text-[11px] text-rose-400 mb-1 block">O RISCO DE ATRASO</span>
            <h3 class="text-white text-base font-medium mb-1">Incerteza na Tramitação</h3>
            <p class="text-xs text-neutral-400 leading-relaxed">
              Processos suspensos por desconformidades em parâmetros objetivos (cérceas, afastamentos, índices) que poderiam ser verificados nos primeiros dias de conceção.
            </p>
          </div>

          <div class="p-6 rounded-xl border border-white/[0.08] bg-[#0c0c0c]">
            <span class="font-mono text-[11px] text-amber-400 mb-1 block">DISPERSÃO DE FONTES</span>
            <h3 class="text-white text-base font-medium mb-1">Versões e Servidões Sobrepostas</h3>
            <p class="text-xs text-neutral-400 leading-relaxed">
              Avisos em Diário da República, revisões de plano e restrições setoriais tornam complexo determinar com rigor os limites vigentes para uma parcela específica.
            </p>
          </div>

          <div class="p-6 rounded-xl border border-white/[0.08] bg-[#0c0c0c]">
            <span class="font-mono text-[11px] text-emerald-400 mb-1 block">A ABORDAGEM DE ENGENHARIA</span>
            <h3 class="text-white text-base font-medium mb-1">Verificação Computável de Requisitos Objetivos</h3>
            <p class="text-xs text-neutral-300 leading-relaxed">
              Estruturação formal das regras que admitem computação e teste direto contra os parâmetros do projeto, com rastreabilidade legal do artigo citado.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- WORKFLOW DISTINCTION -->
  <section class="py-24 px-6 md:px-12 lg:px-20 border-b border-white/[0.08] bg-[#070707]">
    <div class="max-w-6xl mx-auto">
      <div class="max-w-2xl mb-16">
        <div class="mb-4">
          <Tag>DISTINÇÃO DE FLUXO DE TRABALHO</Tag>
        </div>
        <h2 class="text-3xl md:text-4xl font-light text-white tracking-tight leading-tight mb-4">
          Não prospetamos terrenos abstratos.<br />Validamos projetos concretos.
        </h2>
        <p class="text-sm text-neutral-400 leading-relaxed">
          Compreenda a diferença de método entre ferramentas de prospeção territorial e o sistema de pré-validação ImoHarmonia.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="p-8 rounded-2xl border border-white/[0.08] bg-[#0a0a0a]">
          <div class="font-mono text-xs text-neutral-400 uppercase tracking-wider mb-2">Abordagem de Mercado Comum</div>
          <h3 class="text-xl text-neutral-300 font-medium mb-4">Terreno → O que se pode construir?</h3>
          <p class="text-xs text-neutral-400 leading-relaxed mb-6 font-sans">
            A maioria das ferramentas analisa a parcela cadastral e gera estimativas genéricas de viabilidade sem conhecer o programa do arquiteto, a distribuição volumétrica ou a implantação proposta.
          </p>
          <ul class="space-y-2 font-mono text-[11px] text-neutral-400">
            <li>× Não responde se o projeto do arquiteto cumpre o regulamento</li>
            <li>× Gera relatórios genéricos que não verificam o edifício proposto</li>
            <li>× Desconhece a volumetria concreta da operação</li>
          </ul>
        </div>

        <div class="p-8 rounded-2xl border border-emerald-500/30 bg-emerald-950/10 shadow-lg">
          <div class="font-mono text-xs text-emerald-400 uppercase tracking-wider mb-2">Abordagem ImoHarmonia</div>
          <h3 class="text-xl text-white font-medium mb-4">Projeto Concreto → Pode avançar?</h3>
          <p class="text-xs text-neutral-300 leading-relaxed mb-6 font-sans">
            O arquiteto ou engenheiro introduz os dados reais da intervenção. O ImoHarmonia cruza cirurgicamente os factos com o articulado aplicável e emite diagnósticos rastreáveis.
          </p>
          <ul class="space-y-2 font-mono text-[11px] text-emerald-400">
            <li>✓ Verificações reproduzíveis para os parâmetros do projeto desenhado</li>
            <li>✓ Verificação de recuos, cérceas, índices e estacionamento</li>
            <li>✓ Citação exata do artigo e fórmula de cada teste executado</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 8-STEP PIPELINE -->
  <section class="py-24 px-6 md:px-12 lg:px-20 border-b border-white/[0.08]">
    <div class="max-w-6xl mx-auto">
      <div class="max-w-2xl mb-16">
        <div class="mb-4">
          <Tag>PIPELINE DE VALIDAÇÃO</Tag>
        </div>
        <h2 class="text-3xl md:text-4xl font-light text-white tracking-tight leading-tight mb-4">
          A Cadeia de Verificação em 8 Etapas
        </h2>
        <p class="text-sm text-neutral-400 leading-relaxed font-sans">
          Cada projeto é submetido a uma cadeia estruturada de verificações reproduzíveis. Quando um requisito pode ser expresso como regra computável, a sua execução pode ser reproduzida e auditada.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        {pipeline.map((item) => (
          <div class="p-6 rounded-xl border border-white/[0.08] bg-[#0c0c0c] flex flex-col justify-between hover:border-white/20 transition-all">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="font-mono text-xs text-neutral-400">{item.step}</span>
                <span class="font-mono text-[9px] uppercase tracking-wider text-neutral-400 px-2 py-0.5 rounded bg-white/[0.03] border border-white/[0.06]">
                  {item.label}
                </span>
              </div>
              <h3 class="text-base text-white font-medium mb-2">{item.name}</h3>
              <p class="text-xs text-neutral-400 leading-relaxed font-sans">{item.desc}</p>
            </div>
            <div class="mt-6 pt-3 border-t border-white/[0.05] font-mono text-[10px] text-neutral-400">
              Passo {item.step} de 08
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- THE 4 OUTCOMES -->
  <section class="py-24 px-6 md:px-12 lg:px-20 border-b border-white/[0.08] bg-[#070707]">
    <div class="max-w-6xl mx-auto">
      <div class="max-w-2xl mb-16">
        <div class="mb-4">
          <Tag>ESTADOS DO DIAGNÓSTICO</Tag>
        </div>
        <h2 class="text-3xl md:text-4xl font-light text-white tracking-tight leading-tight mb-4">
          Os Quatro Estados de Conformidade
        </h2>
        <p class="text-sm text-neutral-400 leading-relaxed font-sans">
          O sistema não emite percentagens probabilísticas arbitrárias. Classifica os requisitos verificados segundo quatro estados formais de engenharia de conformidade.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="p-6 rounded-2xl border border-emerald-500/25 bg-emerald-950/10">
          <div class="w-3 h-3 rounded-full bg-emerald-400 mb-4"></div>
          <h3 class="font-mono text-sm uppercase tracking-wider text-emerald-400 font-semibold mb-2">Conforme</h3>
          <p class="text-xs text-neutral-300 leading-relaxed font-sans">
            Todos os parâmetros quantitativos verificados respeitam os limites impostos pelos artigos aplicáveis do regulamento municipal e setorial em vigor.
          </p>
        </div>

        <div class="p-6 rounded-2xl border border-amber-500/25 bg-amber-950/10">
          <div class="w-3 h-3 rounded-full bg-amber-400 mb-4"></div>
          <h3 class="font-mono text-sm uppercase tracking-wider text-amber-400 font-semibold mb-2">Condicionado</h3>
          <p class="text-xs text-neutral-300 leading-relaxed font-sans">
            A conformidade depende de condição explícita, compensação urbanística, parecer vinculativo de entidade externa ou aplicação de regime de exceção regulamentar.
          </p>
        </div>

        <div class="p-6 rounded-2xl border border-rose-500/25 bg-rose-950/10">
          <div class="w-3 h-3 rounded-full bg-rose-400 mb-4"></div>
          <h3 class="font-mono text-sm uppercase tracking-wider text-rose-400 font-semibold mb-2">Não Conforme</h3>
          <p class="text-xs text-neutral-300 leading-relaxed font-sans">
            Identificada violação objetiva de parâmetro regulamentar inultrapassável (ex: cércea acima do limite inderrogável ou afetação a uso expressamente interdito).
          </p>
        </div>

        <div class="p-6 rounded-2xl border border-white/15 bg-white/[0.02]">
          <div class="w-3 h-3 rounded-full bg-neutral-400 mb-4"></div>
          <h3 class="font-mono text-sm uppercase tracking-wider text-neutral-300 font-semibold mb-2">Inconclusivo</h3>
          <p class="text-xs text-neutral-400 leading-relaxed font-sans">
            Os dados fornecidos são omissos ou insuficientes para aferir a conformidade, ou o artigo envolve juízo discricionário humano que não admite computação direta.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- PROFESSIONAL RESPONSIBILITY DISCLAIMER -->
  <section class="py-16 px-6 md:px-12 lg:px-20 border-b border-white/[0.08] bg-[#0c0c0c]">
    <div class="max-w-4xl mx-auto flex flex-col md:flex-row items-start gap-6">
      <div class="w-10 h-10 rounded-xl bg-white/[0.05] border border-white/[0.1] flex items-center justify-center shrink-0 text-white font-mono text-sm">
        !
      </div>
      <div>
        <h3 class="text-sm font-mono uppercase tracking-wider text-white mb-2">
          Princípio Ético e Soberania da Decisão Profissional
        </h3>
        <p class="text-xs text-neutral-300 leading-relaxed font-sans">
          O ImoHarmonia é uma infraestrutura de apoio técnico e verificação analítica. Não substitui o julgamento profissional dos arquitetos e engenheiros autores do projeto, nem a competência decisória exclusiva dos técnicos municipais e órgãos autárquicos. O ImoHarmonia confere rigor aos cálculos; a responsabilidade pelo projeto permanece integralmente no profissional.
        </p>
      </div>
    </div>
  </section>

  <!-- QUALIFICATION / TEST SECTION -->
  <section id="testar" class="py-24 px-6 md:px-12 lg:px-20 bg-[#080808]">
    <div class="max-w-3xl mx-auto text-center">
      <div class="inline-flex items-center gap-2 mb-4">
        <Tag>TESTAR COM UM PROJETO</Tag>
      </div>
      <h2 class="text-3xl md:text-5xl font-light text-white tracking-tight leading-[1.05] mb-6">
        Submeta os parâmetros do seu projeto.
      </h2>
      <p class="text-sm text-neutral-400 max-w-xl mx-auto leading-relaxed mb-12 font-sans">
        Indique o município da intervenção, o tipo de operação urbanística e os pontos de dúvida regulatória. A equipa da BolinaTec avaliará a adequação para validação de teste.
      </p>

      <div class="p-8 md:p-10 rounded-2xl border border-white/[0.1] bg-[#0c0c0c] text-left shadow-2xl">
        <ContactForm defaultTopic="imoharmonia" />
      </div>
    </div>
  </section>
</Layout>
