---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Página não encontrada | Bolina Tec" description="Esta página não existe.">
  <section class="min-h-screen flex flex-col items-center justify-center px-6 text-center">
    <p class="text-xs tracking-[0.3em] text-black/30 uppercase mb-4">404</p>
    <h1 class="text-4xl md:text-5xl font-light tracking-tight leading-[1.05] mb-6">
      Página não encontrada.
    </h1>
    <p class="text-sm text-black/45 max-w-sm leading-relaxed mb-10">
      A página que procuras não existe ou foi movida.
    </p>
    <a href="/" class="text-xs tracking-widest uppercase border-b border-black/20 hover:border-black transition-colors pb-0.5">
      Voltar ao início
    </a>
  </section>
</Layout>