---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Tag from '../../components/Tag.astro';

export async function getStaticPaths() {
  const posts = await getCollection('noticias');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout
  title={`${post.data.title} | BolinaTec`}
  description={post.data.description ?? 'Notas de engenharia e sistemas da BolinaTec.'}
>
  <article class="py-24 md:py-32 px-6 md:px-12 lg:px-20 bg-[#080808]">
    <div class="max-w-3xl mx-auto">
      <nav class="mb-10 font-mono text-xs">
        <a href="/noticias" class="text-neutral-400 hover:text-white transition-colors tracking-wider uppercase inline-flex items-center gap-2">
          <span>← Voltar às Notas Técnicas</span>
        </a>
      </nav>

      <div class="mb-8">
        <Tag>NOTA TÉCNICA</Tag>
      </div>

      <h1
        class="text-3xl sm:text-4xl md:text-5xl font-light text-white tracking-tight leading-[1.08] mb-6"
        style="font-family: 'IBM Plex Sans', sans-serif;"
      >
        {post.data.title}
      </h1>

      <div class="flex flex-wrap items-center gap-4 text-xs font-mono text-neutral-400 pb-8 border-b border-white/[0.08]">
        <span>{new Date(post.data.date).toLocaleDateString('pt-PT', { day: '2-digit', month: 'long', year: 'numeric' })}</span>
        {post.data.category && <span>• {post.data.category}</span>}
      </div>

      {post.data.coverImage && (
        <img
          src={post.data.coverImage}
          alt={post.data.title}
          loading="lazy"
          class="mt-10 w-full rounded-2xl border border-white/[0.08] object-cover"
        />
      )}

      <div class="prose-dark mt-10 text-sm md:text-base leading-relaxed text-neutral-300 font-sans space-y-5">
        <Content />
      </div>

      <div class="mt-16 pt-8 border-t border-white/[0.08] flex items-center justify-between font-mono text-xs text-neutral-400">
        <div>BolinaTec • Engenharia Tecnológica</div>
        <a href="/noticias" class="text-white hover:underline underline-offset-4">Ver outras notas →</a>
      </div>
    </div>
  </article>
</Layout>

<style>
  .prose-dark :global(p) {
    margin-bottom: 1.25rem;
    line-height: 1.75;
    color: #d4d4d4;
  }

  .prose-dark :global(h2) {
    font-family: 'IBM Plex Sans', sans-serif;
    font-size: 1.5rem;
    font-weight: 400;
    color: #ffffff;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .prose-dark :global(strong) {
    color: #ffffff;
    font-weight: 600;
  }
</style>
