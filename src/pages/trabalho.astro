---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Tag from '../components/Tag.astro';
import ProductTabs from '../components/ProductTabs.astro';

const allProjetos = await getCollection('projetos');

const maturityTabs = [
  { id: 'todos', label: 'Todos os Projetos' },
  { id: 'produto', label: 'Produtos', badge: '1' },
  { id: 'experiencia', label: 'Experiências', badge: '1' },
  { id: 'investigacao', label: 'Investigação', badge: '1' },
];

const maturityLevels = [
  { step: '01', name: 'Interesse', desc: 'Identificação de fricção real no terreno e análise preliminar de viabilidade.' },
  { step: '02', name: 'Investigação', desc: 'Modelação teórica e formal do problema através de grafos e especificação.' },
  { step: '03', name: 'Experiência', desc: 'Construção de protótipos de computação rápida para validar hipóteses concretas.' },
  { step: '04', name: 'Validação', desc: 'Testagem rigorosa face a dados reais, regulamentos em vigor e utilizadores técnicos.' },
  { step: '05', name: 'Produto', desc: 'Sistema determinístico escalável em produção contínua com garantia de integridade.' },
];
---

<Layout
  title="Portfólio de Engenharia & Sistemas | BolinaTec"
  description="Conheça os projetos, sistemas e investigações tecnológicas desenvolvidos pela BolinaTec, organizados segundo um modelo estrito de maturidade e evidência."
>
  <!-- HERO SECTION -->
  <section class="py-24 md:py-32 px-6 md:px-12 lg:px-20 border-b border-white/[0.08] relative overflow-hidden bg-[#080808]">
    <div class="absolute inset-0 bg-grid-pattern opacity-30 pointer-events-none"></div>

    <div class="max-w-5xl mx-auto relative z-10">
      <div class="inline-flex items-center gap-2 mb-6">
        <Tag>PORTFÓLIO DE ENGENHARIA</Tag>
        <span class="font-mono text-xs text-neutral-400">/ Disciplina de Evidência</span>
      </div>

      <h1
        class="text-4xl sm:text-5xl md:text-6xl font-light text-white tracking-tight leading-[1.05] mb-8"
        style="font-family: 'IBM Plex Sans', sans-serif;"
      >
        Sistemas construídos.<br />
        <span class="text-white font-normal underline decoration-white/30 underline-offset-8">Maturidade comprovada</span>.
      </h1>

      <p class="text-base text-neutral-300 max-w-2xl leading-relaxed font-sans">
        Não apresentamos conceitos sem validação empírica. Cada trabalho da BolinaTec é classificado com transparência absoluta de acordo com a sua maturidade real de engenharia.
      </p>
    </div>
  </section>

  <!-- MATURITY MODEL BAR -->
  <section class="py-16 px-6 md:px-12 lg:px-20 border-b border-white/[0.08] bg-[#070707]">
    <div class="max-w-6xl mx-auto">
      <div class="flex items-center justify-between mb-8">
        <h3 class="font-mono text-xs uppercase tracking-wider text-white">
          A Escala de Maturidade BolinaTec
        </h3>
        <span class="font-mono text-[11px] text-neutral-400">Evidência antes da Afirmação</span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
        {maturityLevels.map((lvl) => (
          <div class="p-5 rounded-xl border border-white/[0.08] bg-[#0c0c0c] flex flex-col justify-between">
            <span class="font-mono text-xs text-neutral-400 mb-2">{lvl.step}</span>
            <div>
              <h4 class="text-sm font-medium text-white mb-1">{lvl.name}</h4>
              <p class="text-[11px] text-neutral-400 leading-relaxed font-sans">{lvl.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PROJECTS DIRECTORY -->
  <section class="py-24 px-6 md:px-12 lg:px-20 border-b border-white/[0.08]">
    <div class="max-w-6xl mx-auto">
      <div class="mb-10">
        <ProductTabs tabs={maturityTabs} defaultTab="todos" />
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6" data-products-grid>
        {allProjetos.map((proj) => (
          <div data-category={proj.data.maturity} class="product-card">
            <div class="h-full p-8 rounded-2xl border border-white/[0.08] bg-[#0c0c0c] flex flex-col justify-between hover:border-white/20 hover:bg-[#111] transition-all group">
              <div>
                <div class="flex items-center justify-between mb-5">
                  <span class={`font-mono text-[10px] tracking-wider uppercase px-2.5 py-0.5 rounded border ${
                    proj.data.maturity === 'produto'
                      ? 'border-emerald-500/30 bg-emerald-500/10 text-emerald-400'
                      : proj.data.maturity === 'experiencia'
                      ? 'border-amber-500/30 bg-amber-500/10 text-amber-400'
                      : 'border-blue-500/30 bg-blue-500/10 text-blue-400'
                  }`}>
                    {proj.data.maturity === 'produto' ? 'Produto' : proj.data.maturity === 'experiencia' ? 'Experiência' : 'Investigação'}
                  </span>
                  <span class="font-mono text-[10px] text-neutral-400">{proj.data.status || 'Ativo'}</span>
                </div>

                <h3 class="text-xl text-white font-medium mb-3 group-hover:text-neutral-100 transition-colors">
                  {proj.data.title}
                </h3>
                <p class="text-xs text-neutral-400 leading-relaxed mb-6 font-sans">
                  {proj.data.shortDescription}
                </p>
              </div>

              <div class="pt-6 border-t border-white/[0.06] flex items-center justify-between">
                <a
                  href={`/projetos/${proj.id}`}
                  class="font-mono text-xs text-white hover:text-neutral-300 transition-colors inline-flex items-center gap-1.5"
                >
                  <span>Ver Especificação</span>
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M5 12h14M12 5l7 7-7 7" />
                  </svg>
                </a>
                {proj.data.externalUrl && (
                  <a
                    href={proj.data.externalUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-mono text-[10px] text-neutral-400 hover:text-white transition-colors"
                  >
                    Aceder ↗
                  </a>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA SECTION -->
  <section class="py-20 px-6 md:px-12 lg:px-20 bg-[#070707]">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-2xl md:text-3xl font-light text-white tracking-tight mb-4">
        Tem um problema de elevada complexidade técnica?
      </h2>
      <p class="text-xs md:text-sm text-neutral-400 max-w-xl mx-auto leading-relaxed mb-8 font-sans">
        Seja na estruturação de dados regulatórios, verificação algorítmica ou arquitetura de software crítico, podemos avaliar o seu contexto.
      </p>
      <a
        href="/contacto"
        class="inline-block px-6 py-3 rounded-xl bg-white text-black font-mono text-xs uppercase tracking-wider font-semibold hover:bg-neutral-200 transition-all shadow-sm"
      >
        Submeter Contexto Técnico
      </a>
    </div>
  </section>
</Layout>
