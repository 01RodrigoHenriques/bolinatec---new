---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { render } from 'astro:content';

export async function getStaticPaths() {
  const projetos = await getCollection('projetos');
  return projetos.map((projeto) => ({
    params: { id: projeto.id },
    props: { projeto },
  }));
}

const { projeto } = Astro.props;
const { Content } = await render(projeto);

const areaLabels = {
  agricultura: 'Agricultura',
  territorio: 'Território',
  inovacao: 'Inovação',
};
---

<Layout title={`${projeto.data.title} | Bolina Tec`} description={projeto.data.shortDescription}>
  <section data-nav-theme="light" class="py-32 px-6 md:px-12 lg:px-20">
    <div class="max-w-4xl mx-auto">
      <!-- Breadcrumb -->
      <nav class="mb-8">
        <a href="/#solucoes" class="text-xs text-black/50 hover:text-black transition-colors tracking-widest uppercase">
          ← Voltar às Soluções
        </a>
      </nav>

      <!-- Header -->
      <div class="mb-12">
        <div class="flex items-center gap-3 mb-4">
          <span class="text-xs font-mono tracking-widest uppercase px-3 py-1 rounded-full border border-black/10 bg-black/5 text-black/70">
            {areaLabels[projeto.data.area]}
          </span>
        </div>
        
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-light tracking-tight leading-[1.05] mb-6" style="font-family: 'IBM Plex Sans', sans-serif;">
          {projeto.data.title}
        </h1>
        
        <p class="text-lg text-black/70 leading-relaxed max-w-2xl">
          {projeto.data.shortDescription}
        </p>
      </div>

      <!-- Image -->
      {projeto.data.image && (
        <div class="mb-12">
          <img 
            src={projeto.data.image}
            alt={projeto.data.title}
            loading="lazy"
            class="w-full rounded-2xl border border-black/[0.07] object-cover"
          />
        </div>
      )}

      <!-- Content -->
      <article class="prose prose-lg max-w-none">
        <Content />
      </article>
    </div>
  </section>
</Layout>

<style>
  article {
    color: #111;
    line-height: 1.7;
  }

  article h2 {
    font-family: 'IBM Plex Sans', sans-serif;
    font-weight: 400;
    font-size: 1.75rem;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }

  article h3 {
    font-family: 'IBM Plex Sans', sans-serif;
    font-weight: 400;
    font-size: 1.25rem;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    letter-spacing: -0.02em;
  }

  article p {
    margin-bottom: 1.25rem;
  }

  article ul, article ol {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }

  article li {
    margin-bottom: 0.5rem;
  }

  article a {
    color: #111;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  article a:hover {
    text-decoration-thickness: 2px;
  }

  article code {
    font-family: 'Geist Mono', monospace;
    background: rgba(0, 0, 0, 0.05);
    padding: 0.2rem 0.4rem;
    border-radius: 0.25rem;
    font-size: 0.875rem;
  }

  article pre {
    background: #0a0a0a;
    color: #fff;
    padding: 1.5rem;
    border-radius: 0.75rem;
    overflow-x: auto;
    margin: 1.5rem 0;
  }

  article pre code {
    background: none;
    padding: 0;
    color: inherit;
  }

  article blockquote {
    border-left: 2px solid rgba(0, 0, 0, 0.1);
    padding-left: 1.5rem;
    margin: 1.5rem 0;
    color: #666;
    font-style: italic;
  }

  article img {
    border-radius: 0.75rem;
    margin: 1.5rem 0;
  }
</style>
