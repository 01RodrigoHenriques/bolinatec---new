---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Tag from '../../components/Tag.astro';

export async function getStaticPaths() {
  const projetos = await getCollection('projetos');
  return projetos.map((projeto) => ({
    params: { id: projeto.id },
    props: { projeto },
  }));
}

const { projeto } = Astro.props;
const { Content } = await render(projeto);

const maturityLabels: Record<string, string> = {
  produto: 'Produto',
  experiencia: 'Experiência',
  investigacao: 'Investigação',
};
---

<Layout
  title={`${projeto.data.title} | BolinaTec`}
  description={projeto.data.shortDescription}
>
  <section class="py-32 px-6 md:px-12 lg:px-20 bg-[#080808]">
    <div class="max-w-4xl mx-auto">
      <!-- Breadcrumb Navigation -->
      <nav class="mb-10 font-mono text-xs">
        <a href="/trabalho" class="text-neutral-400 hover:text-white transition-colors tracking-wider uppercase inline-flex items-center gap-2">
          <span>← Voltar ao Portfólio de Engenharia</span>
        </a>
      </nav>

      <!-- Header -->
      <div class="mb-12 border-b border-white/[0.08] pb-12">
        <div class="flex items-center gap-3 mb-6">
          <Tag variant={projeto.data.maturity === 'produto' ? 'product' : projeto.data.maturity === 'experiencia' ? 'active' : 'research'}>
            {maturityLabels[projeto.data.maturity] || 'Engenharia'}
          </Tag>
          {projeto.data.status && (
            <span class="font-mono text-xs text-neutral-400 border border-white/[0.08] px-2.5 py-0.5 rounded-full bg-white/[0.02]">
              {projeto.data.status}
            </span>
          )}
        </div>

        <h1
          class="text-3xl sm:text-4xl md:text-5xl font-light text-white tracking-tight leading-[1.1] mb-6"
          style="font-family: 'IBM Plex Sans', sans-serif;"
        >
          {projeto.data.title}
        </h1>

        <p class="text-base text-neutral-300 leading-relaxed font-sans max-w-2xl">
          {projeto.data.shortDescription}
        </p>

        {projeto.data.externalUrl && (
          <div class="mt-6">
            <a
              href={projeto.data.externalUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-white text-black font-mono text-xs uppercase tracking-wider font-semibold hover:bg-neutral-200 transition-all"
            >
              <span>Aceder ao Sistema Oficial</span>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3" />
              </svg>
            </a>
          </div>
        )}
      </div>

      <!-- Technical Article Content -->
      <article class="prose-dark font-sans leading-relaxed text-neutral-300 text-sm md:text-base">
        <Content />
      </article>

      <!-- Bottom Context CTA -->
      <div class="mt-16 pt-10 border-t border-white/[0.08] flex flex-col sm:flex-row items-center justify-between gap-6">
        <div>
          <h4 class="text-white font-medium text-sm mb-1">Quer analisar este trabalho com os seus dados?</h4>
          <p class="text-neutral-400 text-xs font-sans">Discuta connosco a aplicação destas ferramentas ao seu projeto.</p>
        </div>
        <a
          href="/contacto"
          class="px-5 py-2.5 rounded-lg border border-white/[0.15] bg-[#111] text-white hover:border-white/40 font-mono text-xs uppercase tracking-wider transition-all"
        >
          Submeter Contexto
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .prose-dark :global(h2) {
    font-family: 'IBM Plex Sans', sans-serif;
    font-weight: 400;
    font-size: 1.5rem;
    color: #ffffff;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    letter-spacing: -0.01em;
  }

  .prose-dark :global(h3) {
    font-family: 'IBM Plex Sans', sans-serif;
    font-weight: 500;
    font-size: 1.15rem;
    color: #e5e5e5;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .prose-dark :global(p) {
    margin-bottom: 1.25rem;
    line-height: 1.75;
    color: #d4d4d4;
  }

  .prose-dark :global(ol),
  .prose-dark :global(ul) {
    margin-bottom: 1.5rem;
    padding-left: 1.25rem;
    color: #d4d4d4;
  }

  .prose-dark :global(li) {
    margin-bottom: 0.5rem;
    line-height: 1.6;
  }

  .prose-dark :global(strong) {
    color: #ffffff;
    font-weight: 600;
  }

  .prose-dark :global(code) {
    font-family: 'Geist Mono', monospace;
    background: rgba(255, 255, 255, 0.08);
    color: #f5f5f5;
    padding: 0.15rem 0.35rem;
    border-radius: 0.25rem;
    font-size: 0.825em;
  }
</style>
