---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import IntroAnimation from '../components/IntroAnimation.astro';
import Tag from '../components/Tag.astro';
import ProductTabs from '../components/ProductTabs.astro';
import ContactForm from '../components/ContactForm.astro';
import { HeroGL } from '../components/HeroGL';

const newsPosts = (await getCollection('noticias'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const teamMembers = await getCollection('equipa');
const allProjetos = await getCollection('projetos');

const workflowSteps = [
  {
    step: '01',
    title: 'Projeto',
    desc: 'Operação urbanística e localização cadastral concreta.',
  },
  {
    step: '02',
    title: 'Factos',
    desc: 'Áreas, cérceas, utilizações e parâmetros arquitetónicos do projeto.',
  },
  {
    step: '03',
    title: 'Contexto Regulatório',
    desc: 'Seleção contextual de PDM, RJUE, RGEU e servidões territoriais.',
  },
  {
    step: '04',
    title: 'Requisitos Aplicáveis',
    desc: 'Decomposição de requisitos em proposições lógicas verificáveis.',
  },
  {
    step: '05',
    title: 'Regras Computáveis',
    desc: 'Algoritmos de cálculo e validação para requisitos quantificáveis.',
  },
  {
    step: '06',
    title: 'Verificações',
    desc: 'Execução reproduzível de verificações computáveis face aos parâmetros.',
  },
  {
    step: '07',
    title: 'Evidência',
    desc: 'Justificação legal, artigo concreto e cálculo que fundamenta o teste.',
  },
  {
    step: '08',
    title: 'Resultado',
    desc: 'Diagnóstico estruturado em 4 estados: Conforme, Condicionado, Não Conforme e Inconclusivo.',
  },
];

const maturityTabs = [
  { id: 'todos', label: 'Todos os Trabalhos' },
  { id: 'produto', label: 'Produtos', badge: '1' },
  { id: 'experiencia', label: 'Experiências', badge: '1' },
  { id: 'investigacao', label: 'Investigação', badge: '1' },
];

const methodSteps = [
  {
    num: '01',
    title: 'Diagnóstico de Restrições',
    tag: 'ESPECIFICAÇÃO FORMAL',
    desc: 'Começamos pelo problema e pelas suas restrições invariantes. Isolamos a complexidade real antes de escrever qualquer linha de arquitetura de software.',
  },
  {
    num: '02',
    title: 'Modelação e Grafos',
    tag: 'ENGENHARIA DE DADOS',
    desc: 'Convertemos regras verbais, normas jurídicas ou processos territoriais em grafos executáveis e especificações lógicas sem ambiguidade.',
  },
  {
    num: '03',
    title: 'Validação com Factos Reais',
    tag: 'EVIDÊNCIA EMPÍRICA',
    desc: 'Nenhuma hipótese avança sem teste empírico rigoroso face a projetos e dados do terreno. Evidência antes da afirmação.',
  },
  {
    num: '04',
    title: 'Construção do Ativo Tecnológico',
    tag: 'SISTEMA ESCALÁVEL',
    desc: 'Entregamos sistemas computáveis e motores de verificação operáveis com integridade e rastreabilidade verificáveis.',
  },
];
---

<Layout
  title="BolinaTec | Engenharia Tecnológica — Sistemas Computáveis"
  description="A BolinaTec é uma empresa portuguesa de engenharia tecnológica que investiga problemas complexos e desenvolve software, sistemas de verificação e produtos computáveis para áreas técnicas e reguladas."
>
  <IntroAnimation />

  <!-- 01 HERO SECTION WITH SPATIAL 3D BOARD -->
  <section
    id="hero"
    data-hero-section
    class="relative min-h-[92vh] flex flex-col justify-center items-center overflow-hidden bg-[#080808] border-b border-white/[0.08]"
  >
    <HeroGL client:only="react" />

    <!-- Atmospheric Gradient Overlays -->
    <div class="absolute inset-x-0 top-0 h-32 pointer-events-none bg-gradient-to-b from-[#080808] via-[#080808]/70 to-transparent z-10"></div>
    <div class="absolute inset-x-0 bottom-0 h-40 pointer-events-none bg-gradient-to-t from-[#080808] via-[#080808]/80 to-transparent z-10"></div>

    <!-- Center Hero Content -->
    <div class="relative z-20 max-w-5xl mx-auto px-6 md:px-12 text-center pt-24 pb-16 pointer-events-none">
      <div class="inline-flex items-center gap-2 mb-6 pointer-events-auto">
        <Tag variant="active">ENGENHARIA TECNOLÓGICA</Tag>
        <span class="font-mono text-xs text-neutral-400 hidden sm:inline-block">/ Lisboa, Portugal</span>
      </div>

      <h1
        class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-light text-white leading-[1.08] tracking-tight mb-8 max-w-4xl mx-auto"
        style="font-family: 'IBM Plex Sans', sans-serif;"
      >
        Transformar complexidade<br class="hidden sm:inline" />
        em <span class="font-normal text-white underline decoration-white/30 underline-offset-8">sistemas computáveis</span>.
      </h1>

      <p class="text-sm md:text-base text-neutral-300 max-w-2xl mx-auto mb-10 leading-relaxed font-sans">
        A BolinaTec é uma empresa portuguesa de engenharia tecnológica que investiga problemas complexos e desenvolve software, sistemas de verificação e produtos computáveis para áreas técnicas e reguladas.
      </p>

      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pointer-events-auto">
        <a
          href="#imoharmonia"
          class="w-full sm:w-auto px-6 py-3 rounded-xl bg-white text-black font-mono text-xs tracking-wider uppercase font-semibold hover:bg-neutral-200 transition-all shadow-md flex items-center justify-center gap-2"
        >
          <span>Conhecer o ImoHarmonia</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        </a>

        <a
          href="/contacto"
          class="w-full sm:w-auto px-6 py-3 rounded-xl bg-[#141414] text-neutral-200 hover:text-white border border-white/[0.12] hover:border-white/30 font-mono text-xs tracking-wider uppercase transition-all flex items-center justify-center gap-2"
        >
          <span>Submeter Contexto Técnico</span>
        </a>
      </div>

      <!-- Operating Principle Micro-Banner -->
      <div class="mt-14 inline-flex items-center justify-center gap-2.5 px-4 py-1.5 rounded-full border border-white/10 bg-[#080808]/90 backdrop-blur-md shadow-sm pointer-events-auto">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 shrink-0"></span>
        <span class="font-mono text-xs text-neutral-300">Princípio: Problema antes da tecnologia. Evidência antes da afirmação.</span>
      </div>
    </div>
  </section>

  <!-- 02 COMPLEXITY: THE REAL-WORLD PROBLEM -->
  <section class="py-24 px-6 md:px-12 lg:px-20 border-b border-white/[0.08] relative">
    <div class="max-w-6xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-[1.2fr_1.8fr] gap-12 lg:gap-20 items-start">
        <div>
          <div class="mb-4">
            <Tag>O PROBLEMA DA COMPLEXIDADE</Tag>
          </div>
          <h2 class="text-3xl md:text-4xl font-light text-white leading-tight tracking-tight mb-6">
            O software comum falha onde o mundo real resiste à computação.
          </h2>
          <p class="text-sm text-neutral-300 leading-relaxed font-sans mb-6">
            Em setores regulados, no planeamento territorial e na indústria técnica, a complexidade não é acidental. Resulta de camadas sucessivas de normas, condições de exceção e restrições interdependentes.
          </p>
          <div class="p-4 rounded-xl border border-white/[0.08] bg-[#0c0c0c] font-mono text-xs text-neutral-300">
            "Tecnologia é mecanismo de implementação. O desafio de engenharia é estruturar o problema."
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="p-6 rounded-xl border border-white/[0.08] bg-[#0d0d0d]">
            <span class="font-mono text-xs text-neutral-400 mb-2 block">01 / DADOS FRAGMENTADOS</span>
            <h3 class="text-base text-white font-medium mb-2">Normas Dispersas</h3>
            <p class="text-xs text-neutral-400 leading-relaxed">
              Centenas de páginas de regulamentos municipais, portarias e decretos-lei cuja interpretação manual consome semanas e acumula atrasos.
            </p>
          </div>

          <div class="p-6 rounded-xl border border-white/[0.08] bg-[#0d0d0d]">
            <span class="font-mono text-xs text-neutral-400 mb-2 block">02 / RISCO TARDIO</span>
            <h3 class="text-base text-white font-medium mb-2">Incerteza no Licenciamento</h3>
            <p class="text-xs text-neutral-400 leading-relaxed">
              Projetos investem recursos significativos antes de verificar se cumprem parâmetros fundamentais de volumetria, afastamento ou uso.
            </p>
          </div>

          <div class="p-6 rounded-xl border border-white/[0.08] bg-[#0d0d0d]">
            <span class="font-mono text-xs text-neutral-400 mb-2 block">03 / ABSTRAÇÕES FALSAS</span>
            <h3 class="text-base text-white font-medium mb-2">Soluções Genéricas</h3>
            <p class="text-xs text-neutral-400 leading-relaxed">
              Plataformas que prometem automação através de palpites estatísticos quando a análise exige verificação lógica estrita.
            </p>
          </div>

          <div class="p-6 rounded-xl border border-white/[0.08] bg-[#0d0d0d]">
            <span class="font-mono text-xs text-neutral-400 mb-2 block">04 / FALTA DE EVIDÊNCIA</span>
            <h3 class="text-base text-white font-medium mb-2">Invisibilidade dos Passos</h3>
            <p class="text-xs text-neutral-400 leading-relaxed">
              Resultados que não demonstram o artigo, o cálculo ou o raciocínio legal que sustentam a conclusão.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 03 THE METAPHOR: BOARD, PAWN, PROGRESSION -->
  <section class="py-24 px-6 md:px-12 lg:px-20 border-b border-white/[0.08] bg-[#070707] relative overflow-hidden">
    <div class="absolute inset-0 bg-grid-pattern opacity-30 pointer-events-none"></div>

    <div class="max-w-6xl mx-auto relative z-10">
      <div class="max-w-2xl mb-16">
        <div class="mb-4">
          <Tag>MODELO DE PROGRESSÃO</Tag>
        </div>
        <h2 class="text-3xl md:text-4xl font-light text-white leading-tight tracking-tight mb-4">
          Avanço quadrado a quadrado. Evidência a cada passo.
        </h2>
        <p class="text-sm text-neutral-400 leading-relaxed">
          Na BolinaTec, cada projeto opera num espaço rigoroso de restrições. O avanço faz-se não por presunção, mas por validação demonstrável dos factos.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-8 rounded-2xl border border-white/[0.08] bg-[#0a0a0a] flex flex-col justify-between">
          <div>
            <div class="w-10 h-10 rounded-lg bg-white/[0.04] border border-white/[0.08] flex items-center justify-center font-mono text-sm text-neutral-300 mb-6">
              01
            </div>
            <h3 class="text-lg text-white font-medium mb-2">O Espaço de Restrições: O Campo Normativo</h3>
            <p class="text-xs text-neutral-400 leading-relaxed">
              A grelha representa o conjunto total de condicionantes, normas vigentes, servidões administrativas e limites físicos. O avanço faz-se no estrito respeito pelas regras do terreno.
            </p>
          </div>
          <div class="mt-8 pt-4 border-t border-white/[0.06] font-mono text-[11px] text-neutral-400">
            Topologia de Restrições
          </div>
        </div>

        <div class="p-8 rounded-2xl border border-white/[0.15] bg-[#0f0f0f] shadow-lg flex flex-col justify-between relative">
          <div class="absolute -top-3 right-6">
            <span class="font-mono text-[9px] px-2 py-0.5 rounded bg-white text-black font-semibold uppercase tracking-wider">
              Em Validação
            </span>
          </div>
          <div>
            <div class="w-10 h-10 rounded-lg bg-white/10 border border-white/20 flex items-center justify-center font-mono text-sm text-white mb-6">
              02
            </div>
            <h3 class="text-lg text-white font-medium mb-2">A Hipótese Concreta: Validação Passo a Passo</h3>
            <p class="text-xs text-neutral-300 leading-relaxed">
              A hipótese técnica ou projeto em análise não salta etapas nem assume pressupostos não verificados. Cada avanço exige a prova formal dos factos onde assenta.
            </p>
          </div>
          <div class="mt-8 pt-4 border-t border-white/[0.06] font-mono text-[11px] text-white">
            Validação Ponto a Ponto
          </div>
        </div>

        <div class="p-8 rounded-2xl border border-white/[0.08] bg-[#0a0a0a] flex flex-col justify-between">
          <div>
            <div class="w-10 h-10 rounded-lg bg-white/[0.04] border border-white/[0.08] flex items-center justify-center font-mono text-sm text-neutral-300 mb-6">
              03
            </div>
            <h3 class="text-lg text-white font-medium mb-2">O Ativo Tecnológico: Sistema Verificado</h3>
            <p class="text-xs text-neutral-400 leading-relaxed">
              Ao demonstrar conformidade com evidência completa, a solução consolida-se como um ativo computável escalável e auditável para operação contínua.
            </p>
          </div>
          <div class="mt-8 pt-4 border-t border-white/[0.06] font-mono text-[11px] text-neutral-400">
            Sistema Auditável
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 04 PRIMARY PRODUCT: IMOHARMONIA -->
  <section id="imoharmonia" class="py-28 px-6 md:px-12 lg:px-20 border-b border-white/[0.08] relative">
    <div class="max-w-6xl mx-auto">
      <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-8 mb-16">
        <div>
          <div class="inline-flex items-center gap-2 mb-4">
            <Tag variant="product">EM VALIDAÇÃO COM PROJETOS REAIS</Tag>
            <span class="font-mono text-xs text-emerald-400">Urbanismo Computável</span>
          </div>
          <h2 class="text-4xl md:text-5xl font-light text-white tracking-tight leading-[1.05]">
            ImoHarmonia.<br />
            <span class="text-neutral-400 font-normal">"Este projeto pode avançar?"</span>
          </h2>
        </div>
        <div class="max-w-md">
          <p class="text-sm text-neutral-300 leading-relaxed font-sans mb-4">
            Motor de pré-validação regulatória que analisa projetos concretos de arquitetura e engenharia face a regras computáveis de regulamentos municipais (PDM), RJUE e normas setoriais.
          </p>
          <a
            href="/imoharmonia"
            class="font-mono text-xs text-white hover:text-neutral-300 transition-colors inline-flex items-center gap-2 underline underline-offset-4 decoration-white/30"
          >
            Ver documentação completa do ImoHarmonia
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14M12 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>

      <!-- WORKFLOW DISTINCTION CARD -->
      <div class="p-6 md:p-8 rounded-2xl border border-white/[0.1] bg-[#0c0c0c] mb-12">
        <h3 class="font-mono text-xs uppercase tracking-wider text-neutral-300 mb-4">
          A Distinção Fundamental de Fluxo de Trabalho
        </h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="p-5 rounded-xl border border-white/[0.05] bg-black/40">
            <div class="font-mono text-xs text-rose-400 mb-2">ABORDAGEM TRADICIONAL (TERRENO PRIMEIRO)</div>
            <div class="font-mono text-xs text-neutral-400 mb-2">TERRENO / LOCALIZAÇÃO → O que se poderia construir aqui?</div>
            <p class="text-xs text-neutral-400 leading-relaxed">
              Gera relatórios genéricos sobre potenciais abstratos que não respondem à volumetria ou programa funcional do projetista.
            </p>
          </div>

          <div class="p-5 rounded-xl border border-emerald-500/20 bg-emerald-950/10">
            <div class="font-mono text-xs text-emerald-400 mb-2">ABORDAGEM IMOHARMONIA (PROJETO PRIMEIRO)</div>
            <div class="font-mono text-xs text-white mb-2">PROJETO CONCRETO → O que podemos verificar antes da submissão?</div>
            <p class="text-xs text-neutral-300 leading-relaxed">
              O profissional insere os parâmetros reais do projeto. O motor isola cirurgicamente as regras aplicáveis e emite diagnósticos rastreáveis.
            </p>
          </div>
        </div>
      </div>

      <!-- 8-STEP PIPELINE DIAGRAM -->
      <div class="mb-12">
        <div class="flex items-center justify-between mb-6">
          <h3 class="font-mono text-xs uppercase tracking-wider text-white">
            Cadeia de Computação e Verificação (8 Etapas)
          </h3>
          <span class="font-mono text-[11px] text-neutral-400">Rastreabilidade de Evidência</span>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-8 gap-2">
          {workflowSteps.map((step) => (
            <div class="p-3.5 rounded-xl border border-white/[0.08] bg-[#0c0c0c] flex flex-col justify-between min-h-[140px] hover:border-white/20 transition-colors">
              <span class="font-mono text-[10px] text-neutral-400">{step.step}</span>
              <div>
                <h4 class="text-xs font-medium text-white mb-1">{step.title}</h4>
                <p class="text-[10px] text-neutral-400 leading-tight">{step.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- 4 POSSIBLE RESULTS -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-12">
        <div class="p-5 rounded-xl border border-emerald-500/20 bg-emerald-950/10">
          <div class="flex items-center gap-2 mb-2">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            <span class="font-mono text-xs text-emerald-400 font-semibold">CONFORME</span>
          </div>
          <p class="text-xs text-neutral-300 leading-relaxed">
            Todos os requisitos quantitativos verificados cumprem os limites regulamentares com rastreabilidade documental.
          </p>
        </div>

        <div class="p-5 rounded-xl border border-amber-500/20 bg-amber-950/10">
          <div class="flex items-center gap-2 mb-2">
            <span class="w-2 h-2 rounded-full bg-amber-400"></span>
            <span class="font-mono text-xs text-amber-400 font-semibold">CONDICIONADO</span>
          </div>
          <p class="text-xs text-neutral-300 leading-relaxed">
            Viável mediante cumprimento de condicionante explícita (e.g. parecer de entidade externa ou ajuste de cércea).
          </p>
        </div>

        <div class="p-5 rounded-xl border border-rose-500/20 bg-rose-950/10">
          <div class="flex items-center gap-2 mb-2">
            <span class="w-2 h-2 rounded-full bg-rose-400"></span>
            <span class="font-mono text-xs text-rose-400 font-semibold">NÃO CONFORME</span>
          </div>
          <p class="text-xs text-neutral-300 leading-relaxed">
            Violação objetiva de parâmetro urbanístico identificada com citação direta do artigo e valor em falta.
          </p>
        </div>

        <div class="p-5 rounded-xl border border-white/10 bg-white/[0.02]">
          <div class="flex items-center gap-2 mb-2">
            <span class="w-2 h-2 rounded-full bg-neutral-400"></span>
            <span class="font-mono text-xs text-neutral-300 font-semibold">INCONCLUSIVO</span>
          </div>
          <p class="text-xs text-neutral-400 leading-relaxed">
            Falta de dados geométricos ou parâmetros insuficientes para aferir a conformidade (não assumimos conformidade por presunção).
          </p>
        </div>
      </div>

      <!-- DISCLAIMER & CTA -->
      <div class="p-6 rounded-2xl border border-white/[0.08] bg-[#0a0a0a] flex flex-col md:flex-row items-center justify-between gap-6">
        <div class="text-xs text-neutral-300 max-w-2xl leading-relaxed">
          <span class="text-white font-medium">Nota de Responsabilidade Profissional:</span> O ImoHarmonia é uma ferramenta de apoio técnico à decisão. Não garante aprovação camarária nem substitui a competência do arquiteto, do engenheiro ou dos serviços municipais.
        </div>
        <a
          href="/contacto?topic=imoharmonia"
          class="shrink-0 px-6 py-3 rounded-xl bg-white text-black font-mono text-xs uppercase tracking-wider font-semibold hover:bg-neutral-200 transition-all shadow-sm"
        >
          Testar com um projeto
        </a>
      </div>
    </div>
  </section>

  <!-- 05 HOW WE WORK: ENGINEERING DISCIPLINE -->
  <section id="workflow" class="py-24 px-6 md:px-12 lg:px-20 border-b border-white/[0.08] bg-[#070707]">
    <div class="max-w-6xl mx-auto">
      <div class="max-w-2xl mb-16">
        <div class="mb-4">
          <Tag>MÉTODO DE ENGENHARIA</Tag>
        </div>
        <h2 class="text-3xl md:text-4xl font-light text-white tracking-tight leading-tight mb-4">
          Como trabalhamos.<br />Do diagnóstico ao sistema verificado.
        </h2>
        <p class="text-sm text-neutral-400 leading-relaxed">
          Problema antes da tecnologia. Evidência antes da afirmação. Quatro etapas que garantem rigor do primeiro dia até à validação operacional.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {methodSteps.map((step) => (
          <div class="p-8 rounded-2xl border border-white/[0.08] bg-[#0c0c0c] flex flex-col justify-between hover:border-white/20 transition-colors">
            <div>
              <div class="flex items-center justify-between mb-6">
                <span class="font-mono text-lg text-white font-light">{step.num}</span>
                <span class="font-mono text-[10px] tracking-wider text-neutral-300 uppercase px-2 py-0.5 rounded border border-white/[0.08] bg-white/[0.02]">
                  {step.tag}
                </span>
              </div>
              <h3 class="text-lg text-white font-medium mb-3">{step.title}</h3>
              <p class="text-xs text-neutral-400 leading-relaxed font-sans">{step.desc}</p>
            </div>
            <div class="mt-8 pt-4 border-t border-white/[0.05] flex items-center justify-between font-mono text-[11px] text-neutral-400">
              <span>Etapa {step.num} / 04</span>
              <span>Critério de Rigor</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 06 PORTFOLIO & MATURITY MODEL -->
  <section id="trabalho" class="py-24 px-6 md:px-12 lg:px-20 border-b border-white/[0.08]">
    <div class="max-w-6xl mx-auto">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
        <div>
          <div class="mb-4">
            <Tag>PORTFÓLIO DE ENGENHARIA</Tag>
          </div>
          <h2 class="text-3xl md:text-4xl font-light text-white tracking-tight leading-tight">
            Trabalhos e Modelo de Maturidade
          </h2>
        </div>
        <p class="text-xs font-mono text-neutral-400 max-w-sm">
          Classificação rigorosa por maturidade real. Nunca afirmamos um nível de produto sem prova de validação técnica.
        </p>
      </div>

      <!-- Maturity Filter Tabs -->
      <ProductTabs tabs={maturityTabs} defaultTab="todos" />

      <!-- Projects Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6" data-products-grid>
        {allProjetos.map((proj) => (
          <div data-category={proj.data.maturity} class="product-card">
            <div class="h-full p-7 rounded-2xl border border-white/[0.08] bg-[#0c0c0c] flex flex-col justify-between hover:border-white/20 hover:bg-[#111111] transition-all group">
              <div>
                <div class="flex items-center justify-between mb-4">
                  <span class={`font-mono text-[10px] tracking-wider uppercase px-2.5 py-0.5 rounded border ${
                    proj.data.maturity === 'produto'
                      ? 'border-emerald-500/30 bg-emerald-500/10 text-emerald-400'
                      : proj.data.maturity === 'experiencia'
                      ? 'border-amber-500/30 bg-amber-500/10 text-amber-400'
                      : 'border-blue-500/30 bg-blue-500/10 text-blue-400'
                  }`}>
                    {proj.data.maturity === 'produto' ? 'Produto' : proj.data.maturity === 'experiencia' ? 'Experiência' : 'Investigação'}
                  </span>
                  <span class="font-mono text-[10px] text-neutral-400">{proj.data.status || 'Ativo'}</span>
                </div>

                <h3 class="text-lg text-white font-medium mb-3 group-hover:text-neutral-100 transition-colors">
                  {proj.data.title}
                </h3>
                <p class="text-xs text-neutral-400 leading-relaxed mb-6 font-sans">
                  {proj.data.shortDescription}
                </p>
              </div>

              <div class="pt-4 border-t border-white/[0.06] flex items-center justify-between">
                <a
                  href={`/projetos/${proj.id}`}
                  class="font-mono text-xs text-white hover:text-neutral-300 transition-colors inline-flex items-center gap-1.5"
                >
                  <span>Ver Especificação</span>
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M5 12h14M12 5l7 7-7 7" />
                  </svg>
                </a>
                {proj.data.externalUrl && (
                  <a
                    href={proj.data.externalUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-mono text-[10px] text-neutral-400 hover:text-white transition-colors"
                  >
                    Site Oficial ↗
                  </a>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 07 ENGINEERING PHILOSOPHY -->
  <section class="py-24 px-6 md:px-12 lg:px-20 border-b border-white/[0.08] bg-[#070707]">
    <div class="max-w-6xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div>
          <div class="mb-4">
            <Tag>FILOSOFIA DE ENGENHARIA</Tag>
          </div>
          <h2 class="text-3xl md:text-4xl font-light text-white tracking-tight leading-tight mb-6">
            Rigor, Rastreabilidade e Execução Algorítmica.
          </h2>
          <p class="text-sm text-neutral-300 leading-relaxed font-sans mb-6">
            A tecnologia não é o posicionamento da BolinaTec; é o mecanismo com que materializamos soluções. Escolhemos ferramentas em função das garantias operacionais e de integridade que fornecem.
          </p>
          <ul class="space-y-4 font-sans text-xs text-neutral-300">
            <li class="flex items-start gap-3">
              <span class="w-1.5 h-1.5 rounded-full bg-white mt-1.5 shrink-0"></span>
              <span><strong>Execução Reproduzível:</strong> Regras codificadas são avaliadas de forma reproduzível com rastreabilidade formal do artigo legal e cálculo aplicável.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="w-1.5 h-1.5 rounded-full bg-white mt-1.5 shrink-0"></span>
              <span><strong>Autonomia Operacional:</strong> Criamos sistemas que o cliente e o utilizador final podem operar e validar sem dependência permanente.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="w-1.5 h-1.5 rounded-full bg-white mt-1.5 shrink-0"></span>
              <span><strong>Soberania de Dados:</strong> Arquitetura orientada à privacidade e integridade dos registos de cada projeto submetido.</span>
            </li>
          </ul>
        </div>

        <div class="p-8 rounded-2xl border border-white/[0.08] bg-[#0b0b0b]">
          <h3 class="font-mono text-xs uppercase tracking-wider text-white mb-6">Valores de Operação</h3>
          <div class="space-y-6">
            <div class="border-b border-white/[0.06] pb-4">
              <div class="font-mono text-xs text-white mb-1">PRECISO</div>
              <p class="text-xs text-neutral-400 leading-relaxed">Tolerância zero para ambiguidades normativas ou cálculos não justificados.</p>
            </div>
            <div class="border-b border-white/[0.06] pb-4">
              <div class="font-mono text-xs text-white mb-1">SÓBRIO</div>
              <p class="text-xs text-neutral-400 leading-relaxed">Sem promessas inflacionadas, sem jargão desnecessário, sem artifícios visuais supérfluos.</p>
            </div>
            <div class="border-b border-white/[0.06] pb-4">
              <div class="font-mono text-xs text-white mb-1">CONCRETO</div>
              <p class="text-xs text-neutral-400 leading-relaxed">Foco no projeto real e nos seus parâmetros específicos antes de qualquer generalização.</p>
            </div>
            <div>
              <div class="font-mono text-xs text-white mb-1">TRANSPARENTE</div>
              <p class="text-xs text-neutral-400 leading-relaxed">Evidência aberta de cada passo de validação, artigo citado e metodologia utilizada.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 08 QUALIFICATION CONTACT SECTION -->
  <section id="contacto" class="py-28 px-6 md:px-12 lg:px-20 relative overflow-hidden bg-[#080808]">
    <div class="max-w-4xl mx-auto text-center">
      <div class="inline-flex items-center gap-2 mb-4">
        <Tag>CONTACTO DE QUALIFICAÇÃO</Tag>
      </div>
      <h2 class="text-3xl md:text-5xl font-light text-white tracking-tight leading-[1.05] mb-6">
        Submeter Contexto Técnico.
      </h2>
      <p class="text-sm text-neutral-400 max-w-xl mx-auto leading-relaxed mb-12 font-sans">
        Tem um projeto concreto para pré-validar no ImoHarmonia ou um desafio de engenharia de sistemas? Partilhe o seu contexto e entraremos em contacto com um próximo passo estruturado.
      </p>

      <div class="p-8 md:p-10 rounded-2xl border border-white/[0.1] bg-[#0c0c0c] shadow-2xl text-left">
        <ContactForm defaultTopic="imoharmonia" />
      </div>

      <div class="mt-8 font-mono text-xs text-neutral-400 flex items-center justify-center gap-4">
        <span>Canal direto: <a href="mailto:geral@bolinatec.com" class="text-neutral-300 hover:text-white underline underline-offset-4 decoration-white/20">geral@bolinatec.com</a></span>
        <span>•</span>
        <span>Lisboa, Portugal</span>
      </div>
    </div>
  </section>
</Layout>