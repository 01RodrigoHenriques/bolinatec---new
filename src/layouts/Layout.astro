---
import MobileNav from '../components/MobileNav.astro';
import NavScript from '../components/NavScript.astro';
import '../styles/global.css';

const {
  title = 'Bolina Tec | Consultoria Tecnológica',
  description = 'A Bolina Tec presta consultoria tecnológica e desenvolve soluções digitais aplicadas a agricultura, território e inovação técnica.',
  image = '/images/uploads/logo.webp',
  canonical,
} = Astro.props;

const resolvedCanonical = canonical || new URL(Astro.url.pathname, Astro.site).href;
const resolvedImage = new URL(image, Astro.site).href;
---

<!doctype html>
<html lang="pt-PT">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={resolvedCanonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={resolvedCanonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={resolvedImage} />
    <meta property="og:locale" content="pt_PT" />
    <meta property="og:site_name" content="Bolina Tec" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedImage} />

    <!-- Favicon -->
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Courier+Prime:wght@400;700&family=Geist:wght@300;400;500;600;700&family=Geist+Mono:wght@400;500;600;700&family=IBM+Plex+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ProfessionalService",
      "name": "Bolina Tec",
      "description": description,
      "url": "https://bolinatec.com",
      "logo": resolvedImage,
      "areaServed": "PT",
      "knowsAbout": ["Consultoria Tecnológica", "Agricultura", "Território", "Inovação"],
      "contactPoint": {
        "@type": "ContactPoint",
        "email": "geral@bolinatec.com",
        "contactType": "customer service"
      }
    })} />

    <slot name="head" />
  </head>
  <body class="font-sans antialiased bg-[#F5F4F0] text-[#111] min-h-screen">
    <a href="#conteudo" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[200] focus:bg-black focus:text-white focus:px-4 focus:py-2 focus:rounded-lg focus:text-sm focus:outline-none">
      Saltar para o conteúdo
    </a>

    <header>
      <MobileNav />
    </header>
    <main id="conteudo">
      <slot />
    </main>

    <footer class="relative bg-[#F5F4F0] border-t border-black/[0.06] overflow-hidden">
      <div class="absolute inset-0 opacity-[0.03] pointer-events-none" style="background-image: radial-gradient(circle, #000 1px, transparent 1px); background-size: 24px 24px;"></div>

      <div class="relative max-w-6xl mx-auto px-6 md:px-12 lg:px-20 pt-16 pb-8">
        <div class="grid grid-cols-1 md:grid-cols-[1.4fr_1fr_1fr_1fr] gap-12 md:gap-8 mb-16">
          <div>
            <a href="/" class="inline-block mb-5">
              <img src="/images/favicon.png" alt="Bolina Tec" class="h-8 w-auto" style="filter: invert(1);" />
            </a>
            <p class="text-sm text-black/50 leading-relaxed max-w-xs mb-5">
              Consultoria tecnológica e desenvolvimento de soluções digitais aplicadas a agricultura, território e inovação técnica.
            </p>
            <a href="https://bolinatec.com" class="text-sm text-black/70 underline underline-offset-4 decoration-black/15 hover:decoration-black/40 transition-colors">bolinatec.com</a>
          </div>

          <div>
            <h4 class="text-xs font-medium tracking-[0.2em] uppercase text-black/90 mb-5">Serviços</h4>
            <ul class="space-y-3">
              <li><a href="/#solucoes" class="text-sm text-black/45 hover:text-black transition-colors">Soluções</a></li>
              <li><a href="/#workflow" class="text-sm text-black/45 hover:text-black transition-colors">Como Trabalhamos</a></li>
              <li><a href="/noticias/" class="text-sm text-black/45 hover:text-black transition-colors">Notícias</a></li>
            </ul>
          </div>

          <div>
            <h4 class="text-xs font-medium tracking-[0.2em] uppercase text-black/90 mb-5">Empresa</h4>
            <ul class="space-y-3">
              <li><a href="/#equipa" class="text-sm text-black/45 hover:text-black transition-colors">Equipa</a></li>
              <li><a href="/#contacto" class="text-sm text-black/45 hover:text-black transition-colors">Contacto</a></li>
              <li><a href="/#solucoes" class="text-sm text-black/45 hover:text-black transition-colors">Projetos</a></li>
            </ul>
          </div>

          <div>
            <h4 class="text-xs font-medium tracking-[0.2em] uppercase text-black/90 mb-5">Legal</h4>
            <ul class="space-y-3">
              <li><a href="/privacidade" class="text-sm text-black/45 hover:text-black transition-colors">Privacidade</a></li>
              <li><a href="/termos" class="text-sm text-black/45 hover:text-black transition-colors">Termos e Condições</a></li>
            </ul>
          </div>
        </div>

        <div class="border-t border-black/[0.06] pt-8 flex flex-col md:flex-row items-center justify-between gap-4">
          <span class="text-xs text-black/30">&copy; 2026 Bolina Tec. Todos os direitos reservados.</span>
          <span class="text-xs text-black/30 flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-[#C9A84C]"></span>
            Desenvolvido por <a href="https://www.linkedin.com/in/rodrigohenriques00" class="underline underline-offset-2 decoration-black/15 hover:decoration-black/40 hover:text-black/60 transition-colors">Rodrigo Henriques</a>
          </span>
        </div>
      </div>
    </footer>
    <NavScript />
  </body>
</html>