---
import MobileNav from '../components/MobileNav.astro';
import NavScript from '../components/NavScript.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
}

const {
  title = 'BolinaTec | Engenharia Tecnológica',
  description = 'A BolinaTec é uma empresa portuguesa de engenharia tecnológica que investiga problemas complexos e desenvolve software, sistemas e produtos para os resolver.',
  image = '/images/uploads/logo.webp',
  canonical,
} = Astro.props;

const resolvedCanonical = canonical || new URL(Astro.url.pathname, Astro.site).href;
const resolvedImage = new URL(image, Astro.site).href;
---

<!doctype html>
<html lang="pt-PT" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={resolvedCanonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={resolvedCanonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={resolvedImage} />
    <meta property="og:locale" content="pt_PT" />
    <meta property="og:site_name" content="BolinaTec" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedImage} />

    <!-- Favicon -->
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&family=Geist+Mono:wght@400;500;600;700&family=IBM+Plex+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Corporation",
      "name": "BolinaTec",
      "legalName": "BolinaTec",
      "description": description,
      "url": "https://bolinatec.com",
      "logo": resolvedImage,
      "address": {
        "@type": "PostalAddress",
        "addressCountry": "PT"
      },
      "knowsAbout": [
        "Engenharia de Software",
        "Sistemas Computáveis",
        "Validação Prévia Urbanística",
        "Engenharia de Requisitos Regulatórios",
        "ImoHarmonia"
      ],
      "contactPoint": {
        "@type": "ContactPoint",
        "email": "geral@bolinatec.com",
        "contactType": "corporate"
      }
    })} />

    <slot name="head" />
  </head>
  <body class="font-sans antialiased bg-[#080808] text-[#ededed] min-h-screen flex flex-col justify-between selection:bg-white/20 selection:text-white">
    <a href="#conteudo" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[200] focus:bg-white focus:text-black focus:px-4 focus:py-2 focus:rounded-md focus:text-xs focus:font-mono focus:outline-none">
      Saltar para o conteúdo
    </a>

    <header>
      <MobileNav />
    </header>

    <main id="conteudo" class="flex-grow">
      <slot />
    </main>

    <footer class="relative bg-[#070707] border-t border-white/[0.08] overflow-hidden">
      <!-- Subtle Grid Background -->
      <div class="absolute inset-0 bg-grid-pattern opacity-40 pointer-events-none"></div>

      <div class="relative max-w-6xl mx-auto px-6 md:px-12 lg:px-20 pt-16 pb-12">
        <div class="grid grid-cols-1 md:grid-cols-[1.6fr_1fr_1fr_1fr] gap-12 md:gap-8 mb-16">
          <div>
            <a href="/" class="inline-flex items-center gap-3 mb-5 group">
              <img src="/images/favicon.png" alt="BolinaTec" class="h-7 w-auto brightness-125" />
              <span class="font-mono text-sm tracking-wider uppercase text-white font-medium">BolinaTec</span>
            </a>
            <p class="text-sm text-neutral-400 leading-relaxed max-w-sm mb-4">
              Empresa portuguesa de engenharia tecnológica que investiga problemas complexos e desenvolve software, sistemas e produtos para os resolver.
            </p>
            <div class="font-mono text-xs text-neutral-400">
              <span class="text-neutral-300">Tese:</span> Transformar complexidade em sistemas computáveis.
            </div>
          </div>

          <div>
            <h4 class="font-mono text-xs tracking-[0.18em] uppercase text-white/90 mb-5">Sistemas</h4>
            <ul class="space-y-3 font-sans text-sm">
              <li>
                <a href="/imoharmonia" class="text-neutral-400 hover:text-white transition-colors flex items-center gap-2">
                  <span>ImoHarmonia</span>
                  <span class="font-mono text-[9px] px-1.5 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">EM VALIDAÇÃO</span>
                </a>
              </li>
              <li>
                <a href="/trabalho" class="text-neutral-400 hover:text-white transition-colors">
                  Portfólio de Engenharia
                </a>
              </li>
            </ul>
          </div>

          <div>
            <h4 class="font-mono text-xs tracking-[0.18em] uppercase text-white/90 mb-5">Engenharia</h4>
            <ul class="space-y-3 font-sans text-sm">
              <li><a href="/sobre" class="text-neutral-400 hover:text-white transition-colors">Sobre a Empresa</a></li>
              <li><a href="/sobre#principios" class="text-neutral-400 hover:text-white transition-colors">Princípios Operacionais</a></li>
              <li><a href="/contacto" class="text-neutral-400 hover:text-white transition-colors">Submeter Contexto</a></li>
            </ul>
          </div>

          <div>
            <h4 class="font-mono text-xs tracking-[0.18em] uppercase text-white/90 mb-5">Institucional</h4>
            <ul class="space-y-3 font-sans text-sm">
              <li><a href="/privacidade" class="text-neutral-400 hover:text-white transition-colors">Privacidade</a></li>
              <li><a href="/termos" class="text-neutral-400 hover:text-white transition-colors">Termos de Utilização</a></li>
              <li><a href="mailto:geral@bolinatec.com" class="font-mono text-xs text-neutral-400 hover:text-white transition-colors">geral@bolinatec.com</a></li>
            </ul>
          </div>
        </div>

        <div class="border-t border-white/[0.08] pt-8 flex flex-col md:flex-row items-center justify-between gap-4 font-mono text-xs text-neutral-400">
          <div>
            &copy; 2026 BolinaTec. Sede em Portugal. Todos os direitos reservados.
          </div>
          <div class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400/80"></span>
            <span>Evidência antes da afirmação.</span>
          </div>
        </div>
      </div>
    </footer>
    <NavScript />
  </body>
</html>