---
interface Props {
  class?: string;
  variant?: 'default' | 'product' | 'research' | 'active';
}

const { class: className = '', variant = 'default' } = Astro.props;

const variantStyles = {
  default: 'border-white/[0.1] bg-white/[0.03] text-neutral-400',
  product: 'border-emerald-500/20 bg-emerald-500/10 text-emerald-400',
  research: 'border-blue-500/20 bg-blue-500/10 text-blue-400',
  active: 'border-white/30 bg-white/10 text-white',
};
---

<span class={`inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full font-mono text-[10px] tracking-[0.14em] uppercase border transition-colors ${variantStyles[variant]} ${className}`}>
  <slot />
</span>
