---
// Minimal, non-blocking entrance transition that never traps the user or delays content.
---
<div
  data-page-intro
  class="fixed inset-0 z-50 pointer-events-none bg-black transition-opacity duration-500 ease-out"
  aria-hidden="true"
></div>

<script is:inline>
  (() => {
    const intro = document.querySelector('[data-page-intro]');
    if (!intro) return;
    requestAnimationFrame(() => {
      intro.style.opacity = '0';
      setTimeout(() => intro.remove(), 550);
    });
  })();
</script>
