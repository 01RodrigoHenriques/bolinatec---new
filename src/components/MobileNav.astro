---
const navLinks = [
  { label: 'Sobre', href: '#sobre' },
  { label: 'Serviços', href: '#servicos' },
  { label: 'Soluções', href: '#solucoes' },
  { label: 'Equipa', href: '#equipa' },
  { label: 'Notícias', href: '#noticias' },
  { label: 'Contacto', href: '#contacto' },
];
---

<div data-mobile-nav data-theme="dark" class="fixed top-0 inset-x-0 z-50 pointer-events-none">
  <div class="pointer-events-auto w-full px-6 md:px-12 lg:px-20 py-6">
    <nav data-nav-bar class="flex items-center justify-between">
      <span data-nav-logo class="font-pixel text-xs tracking-[0.25em] text-white/80">LOGO DEPOIS AQUI</span>

      <div class="hidden md:flex items-center gap-8" style="font-family: system-ui, -apple-system, sans-serif;">
        {navLinks.map((link) => (
          <a data-nav-link href={link.href} class="text-[11px] text-white/55 hover:text-white transition-colors duration-200 tracking-[0.15em] uppercase">
            {link.label}
          </a>
        ))}
      </div>

      <div class="flex items-center gap-2">
        <button data-nav-cta class="text-[11px] px-4 py-2 text-[#C9A84C] hover:text-[#E0BE6A] transition-colors duration-200 tracking-[0.15em] uppercase hidden md:block" style="font-family: system-ui, -apple-system, sans-serif;">
          Fale Connosco
        </button>

        <button
          data-mobile-toggle
          class="md:hidden flex flex-col justify-center items-center w-8 h-8 gap-[5px] rounded-lg hover:bg-white/[0.06] transition-colors"
          aria-label="Open menu"
          aria-expanded="false"
          type="button"
        >
          <span data-burger-line class="block h-px bg-white/70 transition-all duration-300 origin-center" style="width:18px;"></span>
          <span data-burger-line class="block h-px bg-white/70 transition-all duration-300" style="width:18px;"></span>
          <span data-burger-line class="block h-px bg-white/70 transition-all duration-300 origin-center" style="width:18px;"></span>
        </button>
      </div>
    </nav>

    <div
      data-mobile-panel
      class="md:hidden mt-3 overflow-hidden transition-all duration-300 ease-in-out"
      style="max-height: 0px; opacity: 0;"
    >
      <div
        data-nav-panel
        class="rounded-2xl border border-white/10 px-2 py-2 flex flex-col"
        style="backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); background: rgba(0,0,0,0.6);"
      >
        {navLinks.map((link) => (
          <a
            href={link.href}
            data-mobile-close
            data-nav-link
            class="px-4 py-3 text-sm text-white/60 hover:text-white hover:bg-white/[0.05] rounded-xl transition-colors tracking-wide"
            style="font-family: system-ui, -apple-system, sans-serif;"
          >
            {link.label}
          </a>
        ))}
        <div class="mt-1 px-2 pb-1">
          <button data-nav-cta class="w-full text-[11px] px-4 py-2.5 text-[#C9A84C] hover:text-[#E0BE6A] transition-colors tracking-wide" style="font-family: system-ui, -apple-system, sans-serif;">
            Fale Connosco
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  [data-mobile-nav][data-theme="light"] [data-nav-logo] {
    color: rgba(0, 0, 0, 0.7);
  }
  [data-mobile-nav][data-theme="light"] [data-nav-link] {
    color: rgba(0, 0, 0, 0.55);
  }
  [data-mobile-nav][data-theme="light"] [data-nav-link]:hover {
    color: rgba(0, 0, 0, 1);
  }
  [data-mobile-nav][data-theme="light"] [data-burger-line] {
    background-color: rgba(0, 0, 0, 0.6);
  }
  [data-mobile-nav][data-theme="light"] [data-nav-panel] {
    background: rgba(245, 244, 240, 0.92);
    border-color: rgba(0, 0, 0, 0.06);
  }
</style>
