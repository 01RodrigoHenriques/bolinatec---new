---
const navLinks = [
  { label: 'Soluções', href: '/#solucoes' },
  { label: 'Como Trabalhamos', href: '/#workflow' },
  { label: 'Notícias', href: '/noticias/' },
  { label: 'Equipa', href: '/#equipa' },
  { label: 'Contacto', href: '/#contacto' },
];
---
<div data-mobile-nav class="fixed top-0 inset-x-0 z-50 flex justify-center pt-4">
  <div class="pill flex items-center gap-2 px-4 py-3 rounded-full transition-all duration-300 max-w-4xl w-full justify-between">

    <!-- Logo -->
    <a href="/" class="flex items-center shrink-0 px-2 py-1 hover:opacity-70 transition-opacity duration-200">
      <img src="/images/favicon.png" alt="" class="h-8 w-auto" style="filter: brightness(1.1) drop-shadow(0 1px 2px rgba(0,0,0,0.3));" />
    </a>

    <!-- Links -->
    <div class="hidden md:flex items-center gap-0.5">
      {navLinks.map((link) => (
        <a href={link.href}
           class="px-3 py-1.5 rounded-full text-[12px] text-white/60 hover:text-white hover:bg-white/[0.08] transition-all duration-200 tracking-wide"
           style="font-family: 'IBM Plex Sans', sans-serif;">
          {link.label}
        </a>
      ))}
    </div>

    <!-- CTA -->
    <a href="/#contacto"
       class="hidden md:block text-[12px] px-4 py-1.5 rounded-full bg-white/[0.08] text-white/70 hover:text-white hover:bg-white/[0.14] transition-all duration-200 tracking-wide border border-white/[0.08]"
       style="font-family: 'IBM Plex Sans', sans-serif;">
      Fala Connosco
    </a>

    <!-- Mobile toggle -->
    <button data-mobile-toggle
            class="md:hidden flex flex-col justify-center items-center w-8 h-8 gap-[5px] rounded-lg hover:bg-white/[0.08] transition-colors"
            aria-label="Abrir menu" aria-expanded="false" type="button">
      <span data-burger-line class="block h-px w-4 bg-white/60 rounded-full transition-all duration-300 origin-center"></span>
      <span data-burger-line class="block h-px w-4 bg-white/60 rounded-full transition-all duration-300"></span>
      <span data-burger-line class="block h-px w-4 bg-white/60 rounded-full transition-all duration-300 origin-center"></span>
    </button>
  </div>

  <!-- Mobile panel -->
  <div data-mobile-panel class="absolute top-full mt-2 w-full max-w-xs overflow-hidden transition-all duration-300 ease-in-out" style="max-height: 0px; opacity: 0;">
    <div class="rounded-xl px-2 py-2 flex flex-col"
         style="background: #0a0a0a; border: 1px solid rgba(255,255,255,0.08); box-shadow: 0 8px 32px rgba(0,0,0,0.3);">
      {navLinks.map((link) => (
        <a href={link.href} data-mobile-close
           class="px-4 py-3 text-[13px] text-white/60 hover:text-white rounded-lg transition-colors"
           style="font-family: 'IBM Plex Sans', sans-serif;">
          {link.label}
        </a>
      ))}
      <div class="mt-2 pt-2 px-2" style="border-top: 1px solid rgba(255,255,255,0.06);">
        <a href="/#contacto"
           class="block w-full text-center text-[12px] px-4 py-2.5 rounded-full bg-white/[0.08] text-white/70 hover:text-white transition-all border border-white/[0.08]"
           style="font-family: 'IBM Plex Sans', sans-serif;">
          Fala Connosco
        </a>
      </div>
    </div>
  </div>
</div>

<style>
  [data-mobile-nav] .pill {
    background: #0a0a0a;
    border: 1px solid rgba(255,255,255,0.06);
    box-shadow: 0 2px 16px rgba(0,0,0,0.15);
  }
</style>

<script>
  (() => {
    const nav = document.querySelector('[data-mobile-nav]');
    if (!nav) return;

    const toggle = nav.querySelector('[data-mobile-toggle]');
    const panel = nav.querySelector('[data-mobile-panel]');
    const lines = Array.from(nav.querySelectorAll('[data-burger-line]'));

    const getFocusable = () => {
      if (!panel) return [];
      return Array.from(panel.querySelectorAll('a[href], button:not([disabled])'));
    };

    const sync = (open) => {
      if (!panel || !toggle) return;
      panel.style.maxHeight = open ? '400px' : '0px';
      panel.style.opacity = open ? '1' : '0';
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Fechar menu' : 'Abrir menu');
      if (lines[0]) lines[0].style.transform = open ? 'translateY(6px) rotate(45deg)' : '';
      if (lines[1]) { lines[1].style.opacity = open ? '0' : '1'; lines[1].style.transform = open ? 'scaleX(0)' : ''; }
      if (lines[2]) lines[2].style.transform = open ? 'translateY(-6px) rotate(-45deg)' : '';
      nav.dataset.open = String(open);
      if (open) {
        const focusable = getFocusable();
        if (focusable.length > 0) requestAnimationFrame(() => focusable[0].focus());
      }
    };

    toggle?.addEventListener('click', () => sync(nav.dataset.open !== 'true'));
    nav.querySelectorAll('[data-mobile-close]').forEach(el => el.addEventListener('click', () => sync(false)));

    panel?.addEventListener('keydown', (e) => {
      if (e.key !== 'Tab') return;
      const focusable = getFocusable();
      if (focusable.length === 0) return;
      if (e.shiftKey) {
        if (document.activeElement === focusable[0]) { e.preventDefault(); focusable[focusable.length - 1].focus(); }
      } else {
        if (document.activeElement === focusable[focusable.length - 1]) { e.preventDefault(); focusable[0].focus(); }
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && nav.dataset.open === 'true') { sync(false); toggle?.focus(); }
    });
  })();
</script>
