---
const navLinks = [
  { label: 'Soluções', href: '/#solucoes' },
  { label: 'Como Trabalhamos', href: '/#workflow' },
  { label: 'Notícias', href: '/noticias/' },
  { label: 'Equipa', href: '/#equipa' },
  { label: 'Contacto', href: '/#contacto' },
];
---
<div data-mobile-nav data-theme="dark" class="fixed top-0 inset-x-0 z-50 pointer-events-none">
  <div class="pointer-events-auto w-full px-6 md:px-12 lg:px-20 py-5">
    <nav class="flex items-center justify-between">

      <!-- Logo -->
   <a href="/" data-nav-logo class="hover:opacity-80 transition-opacity duration-200 shrink-0">
     <img src="/images/favicon.png" alt="Bolina Tec" class="h-15 w-auto" />
  </a>

      <!-- Pill central -->
      <div class="hidden md:flex items-center gap-1 px-2 py-2 rounded-2xl border border-white/10" style="backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); background: rgba(255,255,255,0.06);">
        {navLinks.map((link) => (
          <a data-nav-link href={link.href} class="px-4 py-1.5 rounded-xl text-[11px] text-white/55 hover:text-white hover:bg-white/[0.07] transition-all duration-200 tracking-[0.12em] uppercase whitespace-nowrap">
            {link.label}
          </a>
        ))}
      </div>

      <!-- CTA + burger -->
      <div class="flex items-center gap-2">
        <a href="/#contacto" data-nav-cta class="hidden md:block text-[11px] px-5 py-2 rounded-xl border border-[#C9A84C]/30 text-[#C9A84C] hover:text-[#E0BE6A] hover:border-[#E0BE6A]/40 hover:bg-[#C9A84C]/[0.06] transition-all duration-200 tracking-[0.15em] uppercase" style="font-family: system-ui, -apple-system, sans-serif;">
          Fala Connosco
        </a>
        <button data-mobile-toggle class="md:hidden flex flex-col justify-center items-center w-8 h-8 gap-[5px] rounded-lg hover:bg-white/[0.06] transition-colors" aria-label="Open menu" aria-expanded="false" type="button">
          <span data-burger-line class="block h-px bg-white/70 transition-all duration-300 origin-center" style="width:18px;"></span>
          <span data-burger-line class="block h-px bg-white/70 transition-all duration-300" style="width:18px;"></span>
          <span data-burger-line class="block h-px bg-white/70 transition-all duration-300 origin-center" style="width:18px;"></span>
        </button>
      </div>
    </nav>

    <!-- Mobile panel -->
    <div data-mobile-panel class="md:hidden mt-3 overflow-hidden transition-all duration-300 ease-in-out" style="max-height: 0px; opacity: 0;">
      <div data-nav-panel class="rounded-2xl border border-white/10 px-2 py-2 flex flex-col" style="backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); background: rgba(0,0,0,0.6);">
        {navLinks.map((link) => (
          <a href={link.href} data-mobile-close data-nav-link class="px-4 py-3 text-sm text-white/60 hover:text-white hover:bg-white/[0.05] rounded-xl transition-colors tracking-wide" style="font-family: system-ui, -apple-system, sans-serif;">
            {link.label}
          </a>
        ))}
        <div class="mt-1 px-2 pb-1">
          <a href="/#contacto" class="block w-full text-center text-[11px] px-4 py-2.5 text-[#C9A84C] hover:text-[#E0BE6A] transition-colors tracking-wide" style="font-family: system-ui, -apple-system, sans-serif;">
            Fale Connosco
          </a>
        </div>
      </div>
    </div>
  </div>
</div>
<style>
  [data-mobile-nav][data-theme="light"] [data-nav-logo] { color: rgba(0,0,0,0.7); }
  [data-mobile-nav][data-theme="light"] [data-nav-logo] img { filter: invert(1); }
  [data-mobile-nav][data-theme="light"] [data-nav-link] { color: rgb(255, 255, 255); }
  [data-mobile-nav][data-theme="light"] [data-nav-link]:hover { color: rgb(255, 255, 255); }
  [data-mobile-nav][data-theme="light"] [data-nav-link]:hover { background: rgb(255, 255, 255); }
  [data-mobile-nav][data-theme="light"] [data-burger-line] { background-color: rgba(0,0,0,0.6); }
  [data-mobile-nav][data-theme="light"] [data-nav-panel] { background: rgba(245,244,240,0.92); border-color: rgba(0,0,0,0.06); }
  [data-mobile-nav][data-theme="light"] .pill-nav { background: rgba(0,0,0,0.04); border-color: rgba(0,0,0,0.08); }
</style>
