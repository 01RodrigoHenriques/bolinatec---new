---
interface Tab {
  id: string;
  label: string;
  badge?: string;
}

interface Props {
  tabs: Tab[];
  defaultTab?: string;
}

const { tabs, defaultTab = tabs[0]?.id } = Astro.props;
---

<div class="flex flex-wrap gap-2 md:gap-3 mb-10" data-product-tabs>
  {tabs.map((tab) => (
    <button
      data-tab={tab.id}
      class="product-tab px-4 py-2 rounded-lg font-mono text-xs uppercase tracking-wider transition-all border border-white/[0.08] bg-[#0c0c0c] text-neutral-400 hover:text-white hover:border-white/20 cursor-pointer flex items-center gap-2"
    >
      <span>{tab.label}</span>
      {tab.badge && (
        <span class="text-[9px] px-1.5 py-0.2 rounded bg-white/[0.06] text-neutral-400">
          {tab.badge}
        </span>
      )}
    </button>
  ))}
</div>

<script is:inline define:vars={{ defaultTab }}>
  (() => {
    const tabsContainer = document.querySelector('[data-product-tabs]');
    const grid = document.querySelector('[data-products-grid]');
    if (!tabsContainer || !grid) return;

    const tabs = Array.from(tabsContainer.querySelectorAll('.product-tab'));
    const cards = Array.from(grid.querySelectorAll('.product-card'));

    const setActive = (category) => {
      tabs.forEach(tab => {
        const match = tab.getAttribute('data-tab') === category || category === 'todos';
        const isCurrent = tab.getAttribute('data-tab') === category;
        tab.classList.toggle('border-white/40', isCurrent);
        tab.classList.toggle('text-white', isCurrent);
        tab.classList.toggle('bg-white/[0.08]', isCurrent);
        tab.classList.toggle('text-neutral-400', !isCurrent);
        tab.classList.toggle('bg-[#0c0c0c]', !isCurrent);
      });

      cards.forEach(card => {
        const itemCat = card.getAttribute('data-category');
        const match = category === 'todos' || itemCat === category;
        card.style.opacity = '0';
        card.style.transform = 'translateY(10px)';
        setTimeout(() => {
          card.style.display = match ? 'block' : 'none';
          if (match) {
            requestAnimationFrame(() => {
              card.style.opacity = '1';
              card.style.transform = 'translateY(0)';
            });
          }
        }, 150);
      });
    };

    tabs.forEach(tab => {
      tab.addEventListener('click', () => setActive(tab.getAttribute('data-tab')));
    });

    if (defaultTab) {
      setActive(defaultTab);
    }
  })();
</script>
